digraph single_table {
  graph [rankdir=TB, fontsize=18];
  node [shape=plain, fontname="Arial"];
  label="nagapetyan — logistics_records";
  labelloc=t;
  "logistics_records" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#eeeeee" COLSPAN="3"><B>logistics_records</B></TD></TR><TR><TD><B>Поле</B></TD><TD><B>Тип</B></TD><TD><B>Модификаторы</B></TD></TR><TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">bigint(64,0)</TD><TD ALIGN="LEFT">PK, NOT NULL</TD></TR><TR><TD ALIGN="LEFT">organization_id</TD><TD ALIGN="LEFT">bigint(64,0)</TD><TD ALIGN="LEFT">NOT NULL, FK → organizations.id</TD></TR><TR><TD ALIGN="LEFT">shipment_number</TD><TD ALIGN="LEFT">character varying(128)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">route_from</TD><TD ALIGN="LEFT">character varying(255)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">route_to</TD><TD ALIGN="LEFT">character varying(255)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">shipped_at</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">planned_delivery_date</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">delivered_at</TD><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">character varying(32)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">responsible_department</TD><TD ALIGN="LEFT">character varying(255)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT">character varying(1000)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamp without time zone</TD><TD ALIGN="LEFT">NOT NULL, DEFAULT CURRENT_TIMESTAMP</TD></TR><TR><TD ALIGN="LEFT">weight</TD><TD ALIGN="LEFT">numeric(12,3)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">cost</TD><TD ALIGN="LEFT">numeric(14,2)</TD><TD ALIGN="LEFT">NOT NULL</TD></TR><TR><TD ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT">timestamp without time zone</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">route_from_latitude</TD><TD ALIGN="LEFT">numeric(10,6)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">route_from_longitude</TD><TD ALIGN="LEFT">numeric(10,6)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">route_to_latitude</TD><TD ALIGN="LEFT">numeric(10,6)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">route_to_longitude</TD><TD ALIGN="LEFT">numeric(10,6)</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
}